# ------------------------------------------------------------
# QUESTION 7
# Calculate frequency of letters occurring in a given string.
# ------------------------------------------------------------

print("QUESTION 7")

string = input("Enter a string: ")

frequency = {}

for letter in string:
    if letter in frequency:
        frequency[letter] = frequency[letter] + 1
    else:
        frequency[letter] = 1

print("Frequency of letters:", frequency)
print()


