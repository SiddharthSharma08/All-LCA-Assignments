# QUESTION 8
# Take numerator and denominator from user and give output
# as a tuple of Quotient and Remainder.
# ------------------------------------------------------------

print("QUESTION 8")

numerator = int(input("Enter numerator: "))
denominator = int(input("Enter denominator: "))

quotient = numerator // denominator
remainder = numerator % denominator

result = (quotient, remainder)

print("Tuple of Quotient and Remainder:", result)
print()


# ------------------------------------------------------------
# QUESTION 9
# Date is represented as a tuple (d, m, y).
# Create two date tuples from user input and find the number
# of days between the two dates.
# ------------------------------------------------------------

print("QUESTION 9")

from datetime import date

d1 = int(input("Enter first date (day): "))
m1 = int(input("Enter first date (month): "))
y1 = int(input("Enter first date (year): "))

d2 = int(input("Enter second date (day): "))
m2 = int(input("Enter second date (month): "))
y2 = int(input("Enter second date (year): "))

date_tuple1 = (d1, m1, y1)
date_tuple2 = (d2, m2, y2)

date1 = date(y1, m1, d1)
date2 = date(y2, m2, d2)

days = abs((date2 - date1).days)

print("First date tuple:", date_tuple1)
print("Second date tuple:", date_tuple2)
print("Number of days between the two dates:", days)
